archimate:Access a owl:ObjectProperty ;
    rdfs:label "Access"@en ;
    rdfs:comment "Models the ability of behavior and active structure elements to observe or act upon passive structure elements."@en ;
    rdfs:subPropertyOf archimate:DependencyRelationship .

archimate:BusinessCollaboration a owl:Class ;
    rdfs:subClassOf archimate:BusinessLayer,
        archimate:InternalActiveStructureElement .

archimate:BusinessEvent a owl:Class ;
    rdfs:subClassOf archimate:BusinessLayer,
        archimate:Event .

archimate:CommunicationNetwork a owl:Class ;
    rdfs:subClassOf archimate:InternalActiveStructureElement,
