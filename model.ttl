archimate:Property a owl:DatatypeProperty ;
    rdfs:label "Property"@en ;
    rdfs:comment """Shared super-property for all ArchiMate property definitions.
Each concrete property predicate (e.g. ex:name, ex:age) is declared
rdfs:subPropertyOf archimate:Property, enabling generic querying
across all property values.""" .

